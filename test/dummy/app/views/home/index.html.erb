<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Publication directory",
    subtitle: "A host-app demo of the shared publications catalogue and family admin.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "What's working",
          subtitle: "The dummy host stays thin. Catalogue data and admin live in the gem.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>A shared Publications catalogue holds titles for this host.</li>
          <li>Family admin at <code>/admin</code> opens a demo home. The publications section has totals, charts, and the inventories.</li>
          <li>Each title can have one image logo. Add it after the title exists, on Attachable’s screens.</li>
          <li>Each title can list the articles it published. Add a screenshot after the article exists.</li>
          <li>This dummy host uses a Flatpack sidebar. Title and article screens stay on Recording Studio’s default layout.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(border: :strong) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Open the directory",
          subtitle: "Staff use the publications admin section. Published titles also have a public page.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Sign in as admin@admin.com to manage titles. The inventory, new, show, and edit screens are family admin pages — not a second admin app.
        </p>
      <% end %>

      <% card.footer do %>
        <a href="/admin" class="inline-flex">
          <%= render FlatPack::Button::Component.new(
            text: "Open publications admin",
            style: :primary,
            size: :md
          ) %>
        </a>
      <% end %>
    <% end %>
  </div>
</div>
